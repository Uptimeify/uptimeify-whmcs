{
    "name": "uptimeify/whmcs-addon",
    "description": "WHMCS addon module that mirrors clients, hosting domains and registered domains to uptimeify.io monitoring.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://uptimeify.io",
    "support": {
        "issues": "https://github.com/Uptimeify/uptimeify-whmcs/issues",
        "source": "https://github.com/Uptimeify/uptimeify-whmcs"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/database": "^11.0",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "WHMCS\\Module\\Addon\\Uptimeify\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uptimeify\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": { "php": "8.2.0" },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit"
    }
}
