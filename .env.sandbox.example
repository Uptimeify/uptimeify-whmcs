# Copy to .env.sandbox (gitignored). Never commit.
# The WHMCS installer asks for the licence key; keep it here so it is not lost between rebuilds.
WHMCS_LICENSE_KEY=Dev-your-licence-key-here
# A reachable Uptimeify API instance for testing (e.g. an Uptimeify staging/sandbox environment), reachable from the container.
# Enter it in the module under Settings -> API base URL; never use https://uptimeify.io with a real token here.
UPTIMEIFY_SANDBOX_URL=http://host.docker.internal:3001
